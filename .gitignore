*.obj
*.a
*.lib
*.so
*.dll
*.exe
*.out
*.app
*.elf
*.axf
*.hex
*.bin
*.map
*.lst
*.d
*.crf
*.lnp
*.dep
*.pdb
*.ilk
*.exp
*.su
*.i

